CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    // RAM occupies 0000-3FFF, Screen 4000-5FFF, Keyboard 6000.
    Not(in=address[14], out=notA14);
    Not(in=address[13], out=notA13);
    And(a=notA14, b=notA13, out=ramSelect);
    And(a=notA14, b=address[13], out=screenSelect);
    And(a=load, b=ramSelect, out=loadRam);
    And(a=load, b=screenSelect, out=loadScreen);

    RAM16K(in=in, load=loadRam, address=address[0..13], out=ramOut);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);
    Keyboard(out=keyOut);

    Mux16(a=ramOut, b=screenOut, sel=address[13], out=ramOrScreen);
    Mux16(a=ramOrScreen, b=keyOut, sel=address[14], out=out);
}