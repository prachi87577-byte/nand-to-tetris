CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=instruction[5], out=loadAFromC);
    Or(a=isA, b=loadAFromC, out=loadA);
    And(a=instruction[15], b=instruction[4], out=loadD);
    And(a=instruction[15], b=instruction[3], out=writeM);

    Mux16(a=aluOut, b=instruction, sel=isA, out=aInput);
    ARegister(in=aInput, load=loadA, out=aReg, out=addressM);
    DRegister(in=aluOut, load=loadD, out=dReg);

    Mux16(a=aReg, b=inM, sel=instruction[12], out=aluY);
    ALU(x=dReg, y=aluY, zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8], f=instruction[7],
        no=instruction[6], out=aluOut, out=outM, zr=zr, ng=ng);

    Not(in=zr, out=notZr);
    Not(in=ng, out=notNg);
    And(a=notZr, b=notNg, out=positive);
    Or(a=positive, b=zr, out=positiveOrZero);
    Or(a=positive, b=ng, out=positiveOrNegative);
    Or(a=zr, b=ng, out=zeroOrNegative);

    // Decode the seven jump mnemonics from bits j2 j1 j0.
    Not(in=instruction[2], out=n2);
    Not(in=instruction[1], out=n1);
    Not(in=instruction[0], out=n0);
    And(a=n2, b=n1, out=b00);
    And(a=b00, b=instruction[0], out=code001);
    And(a=n2, b=instruction[1], out=b01);
    And(a=b01, b=n0, out=code010);
    And(a=b01, b=instruction[0], out=code011);
    And(a=instruction[2], b=n1, out=b10);
    And(a=b10, b=n0, out=code100);
    And(a=b10, b=instruction[0], out=code101);
    And(a=instruction[2], b=instruction[1], out=b11);
    And(a=b11, b=n0, out=code110);
    And(a=b11, b=instruction[0], out=code111);

    And(a=code001, b=positive, out=t1);
    And(a=code010, b=zr, out=t2);
    And(a=code011, b=positiveOrZero, out=t3);
    And(a=code100, b=ng, out=t4);
    And(a=code101, b=positiveOrNegative, out=t5);
    And(a=code110, b=zeroOrNegative, out=t6);
    Or(a=t1, b=t2, out=u1);
    Or(a=t3, b=t4, out=u2);
    Or(a=t5, b=t6, out=u3);
    Or(a=u1, b=u2, out=u4);
    Or(a=u4, b=u3, out=u5);
    Or(a=u5, b=code111, out=jump);
    And(a=instruction[15], b=jump, out=pcLoad);

    PC(in=aReg, load=pcLoad, inc=true, reset=reset, out=pc);
}